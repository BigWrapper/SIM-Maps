# Text files are checked out with LF by default.
* text=auto eol=lf
# Windows batch files are checked out with CRLF.
*.bat text eol=crlf
# Binary files are not normalized.
*.bin binary
*.bz2 binary
*.kmz binary
*.mwm binary
*.png binary
*.jpg binary
*.jpeg binary
*.ttf binary
*.slf binary
*.borders binary
*.pdf binary
